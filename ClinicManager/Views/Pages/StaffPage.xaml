<UserControl x:Class="ClinicManager.Views.Pages.StaffPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ClinicManager.Localization"
             xmlns:models="clr-namespace:ClinicManager.Models"
             xmlns:helpers="clr-namespace:ClinicManager.Helpers">

    <UserControl.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid>
        <DockPanel Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
            <DockPanel DockPanel.Dock="Top" Margin="20,16,20,12">
                <StackPanel Orientation="Horizontal">
                    <Border Width="40" Height="40" CornerRadius="8" Background="{DynamicResource PrimaryBrush}" Margin="0,0,12,0">
                        <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{local:Localize StaffManagement}" Style="{DynamicResource PageTitleStyle}" />
                        <TextBlock Text="{local:Localize StaffManagementDesc}" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding RefreshCommand}"
                            Style="{DynamicResource SecondaryButtonStyle}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{local:Localize Refresh}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding AddCommand}"
                            Style="{DynamicResource PrimaryButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{local:Localize AddStaff}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>

            <Border DockPanel.Dock="Top" Margin="20,0,20,12">
                <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                         Style="{DynamicResource ModernTextBoxStyle}"
                         Tag="{local:Localize SearchStaff}" />
            </Border>

            <Border Margin="20,0,20,16" Style="{DynamicResource CardStyle}" Padding="0">
                <DataGrid ItemsSource="{Binding Staff}" SelectedItem="{Binding SelectedStaff}"
                          Style="{DynamicResource ModernDataGridStyle}"
                          ColumnHeaderStyle="{DynamicResource ModernDataGridColumnHeaderStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50" MinWidth="40" />
                        <DataGridTextColumn Header="{local:Localize Name}" Binding="{Binding FullName}" Width="*" MinWidth="100" />
                        <DataGridTextColumn Header="{local:Localize Role}" Binding="{Binding Role}" Width="100" MinWidth="70" />
                        <DataGridTextColumn Header="{local:Localize Phone}" Binding="{Binding Phone}" Width="120" MinWidth="80" />
                        <DataGridTextColumn Header="{local:Localize Email}" Binding="{Binding Email}" Width="180" MinWidth="100" />
                        <DataGridTextColumn Header="{local:Localize Specialization}" Binding="{Binding Specialization}" Width="120" MinWidth="80" />
                        <DataGridTextColumn Header="{local:Localize Status}" Binding="{Binding Status}" Width="80" MinWidth="60" />
                    </DataGrid.Columns>
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{local:Localize Edit}" Command="{Binding EditCommand}" />
                            <MenuItem Header="{local:Localize Delete}" Command="{Binding DeleteCommand}" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                </DataGrid>
            </Border>
        </DockPanel>

        <ScrollViewer Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"
                      VerticalScrollBarVisibility="Auto" Padding="24,20">
            <Border Style="{DynamicResource CardStyle}" MaxWidth="520" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{Binding EditId, StringFormat='Staff #{0}', FallbackValue='New Staff Member'}"
                               Style="{DynamicResource PageTitleStyle}" Margin="0,0,0,20" />

                    <TextBlock Style="{DynamicResource FormLabelStyle}">
                        <Run Text="{local:Localize FullName}" /><Run Text=" *" />
                    </TextBlock>
                    <TextBox Text="{Binding EditFullName, UpdateSourceTrigger=PropertyChanged}"
                             Style="{DynamicResource ModernTextBoxStyle}" Margin="0,0,0,16" />

                    <TextBlock Text="{local:Localize Role}" Style="{DynamicResource FormLabelStyle}" />
                    <ComboBox SelectedItem="{Binding EditRole}" FontSize="13" Padding="10" Margin="0,0,0,16">
                        <models:StaffRole>Dentist</models:StaffRole>
                        <models:StaffRole>Hygienist</models:StaffRole>
                        <models:StaffRole>Nurse</models:StaffRole>
                        <models:StaffRole>Assistant</models:StaffRole>
                        <models:StaffRole>Receptionist</models:StaffRole>
                        <models:StaffRole>Other</models:StaffRole>
                    </ComboBox>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{local:Localize Phone}" Style="{DynamicResource FormLabelStyle}" />
                            <TextBox Text="{Binding EditPhone, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{DynamicResource ModernTextBoxStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{local:Localize Email}" Style="{DynamicResource FormLabelStyle}" />
                            <TextBox Text="{Binding EditEmail, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{DynamicResource ModernTextBoxStyle}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{local:Localize Specialization}" Style="{DynamicResource FormLabelStyle}" />
                    <TextBox Text="{Binding EditSpecialization, UpdateSourceTrigger=PropertyChanged}"
                             Style="{DynamicResource ModernTextBoxStyle}" Margin="0,0,0,16" />

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{local:Localize HireDate}" Style="{DynamicResource FormLabelStyle}" />
                            <DatePicker SelectedDate="{Binding EditHireDate}" FontSize="13" Padding="8" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{local:Localize Status}" Style="{DynamicResource FormLabelStyle}" />
                            <ComboBox SelectedItem="{Binding EditStatus}" FontSize="13" Padding="10">
                                <models:StaffStatus>Active</models:StaffStatus>
                                <models:StaffStatus>Inactive</models:StaffStatus>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{local:Localize Notes}" Style="{DynamicResource FormLabelStyle}" />
                    <TextBox Text="{Binding EditNotes, UpdateSourceTrigger=PropertyChanged}"
                             Style="{DynamicResource ModernTextBoxStyle}" AcceptsReturn="True"
                             MinHeight="60" TextWrapping="Wrap" Margin="0,0,0,24" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{local:Localize Cancel}" Command="{Binding CancelEditCommand}"
                                Style="{DynamicResource SecondaryButtonStyle}" Margin="0,0,8,0" />
                        <Button Content="{local:Localize Save}" Command="{Binding SaveCommand}"
                                Style="{DynamicResource PrimaryButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
