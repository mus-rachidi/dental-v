<Window x:Class="ClinicManager.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ClinicManager.Localization"
        xmlns:helpers="clr-namespace:ClinicManager.Helpers"
        Title="ClinicPro - Sign In"
        Height="520" Width="420" MinHeight="480" MinWidth="380"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}">

    <Window.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVis" />
        <helpers:InverseBoolConverter x:Key="InverseBool" />
        <helpers:StringToVisibilityConverter x:Key="StringToVis" />
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Margin="32">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" CornerRadius="0"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,1,1,0"
                Padding="40,28,40,20">
            <StackPanel>
                <Border Width="48" Height="48" CornerRadius="0" Background="{DynamicResource PrimaryBrush}"
                        HorizontalAlignment="Center" Margin="0,0,0,12">
                    <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="24"
                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="ClinicPro" FontSize="20" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="Sign in to continue" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,1,1"
                Padding="40,24,40,20">
            <StackPanel>
                <TextBlock Text="Username" Style="{DynamicResource FormLabelStyle}" />
                <TextBox x:Name="UsernameBox"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         Style="{DynamicResource ModernTextBoxStyle}"
                         Margin="0,6,0,16"
                         VerticalContentAlignment="Center"
                         IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBool}}"
                         KeyDown="UsernameBox_KeyDown" />

                <TextBlock Text="Password" Style="{DynamicResource FormLabelStyle}" />
                <Grid Margin="0,6,0,8">
                    <PasswordBox x:Name="PasswordBox"
                                 Style="{DynamicResource ModernPasswordBoxStyle}"
                                 VerticalContentAlignment="Center"
                                 PasswordChanged="PasswordBox_PasswordChanged"
                                 IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBool}}"
                                 KeyDown="PasswordBox_KeyDown"
                                 Visibility="{Binding IsPasswordVisible, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                    <TextBox x:Name="PasswordTextBox"
                             Style="{DynamicResource ModernTextBoxStyle}"
                             VerticalContentAlignment="Center"
                             Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBool}}"
                             KeyDown="PasswordTextBox_KeyDown"
                             Visibility="{Binding IsPasswordVisible, Converter={StaticResource BoolToVis}}" />
                </Grid>
                <CheckBox x:Name="ShowPasswordCheck" Content="Show password" IsChecked="{Binding IsPasswordVisible}"
                          Margin="0,0,0,12" Foreground="{DynamicResource TextSecondaryBrush}"
                          Checked="ShowPasswordCheck_Changed" Unchecked="ShowPasswordCheck_Changed"
                          IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBool}}" />
                <Button Content="Use demo credentials" Click="UseDefault_Click"
                        Margin="0,0,0,16" MinHeight="36" FontSize="12"
                        Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextSecondaryBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBool}}"
                        Visibility="{Binding ShowDemoCredentials, Converter={StaticResource BoolToVis}}" />

                <!-- Error message - visible box when there is an error -->
                <Border x:Name="ErrorBorder" Margin="0,0,0,16" Padding="14,12" CornerRadius="0"
                        Background="{DynamicResource DangerLightBrush}"
                        BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE783;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                   Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}"
                                   FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Button row - always visible at bottom -->
        <Border x:Name="ButtonRowBorder" Grid.Row="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="0"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,1,1"
                Padding="40,20,40,28">
            <StackPanel>
                <TextBlock Text="Signing in..." FontSize="12" Foreground="{DynamicResource PrimaryBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,6"
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
                <Button x:Name="SignInButton"
                        Content="Sign In"
                        Click="SignInButton_Click"
                        Style="{DynamicResource PrimaryButtonStyle}"
                        Background="{DynamicResource PrimaryBrush}"
                        Foreground="White"
                        MinHeight="48"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Padding="0"
                        Margin="0,0,0,14"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBool}}"
                        Cursor="Hand"
                        Focusable="True"
                        IsDefault="True"
                        IsCancel="False" />
                <TextBlock Text="Demo account available for testing" FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}"
                           HorizontalAlignment="Center"
                           Visibility="{Binding ShowDemoCredentials, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </Border>
    </Grid>
    </ScrollViewer>
</Window>
