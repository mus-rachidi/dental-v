<Window x:Class="ClinicManager.Views.Dialogs.LicenseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="License Activation" Height="560" Width="520" MinHeight="400" MinWidth="480"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource BackgroundBrush}" WindowStyle="SingleBorderWindow">

    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            Margin="0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="24,20">
            <StackPanel VerticalAlignment="Center" MinWidth="400">
                <!-- Logo -->
                <Border Width="48" Height="48" Background="{DynamicResource PrimaryBrush}" 
                        HorizontalAlignment="Center" Margin="0,0,0,12"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Clinic Manager" FontSize="18" FontWeight="Bold" 
                           Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" FontFamily="Tahoma" />
                <TextBlock Text="Activate your license to continue" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"
                           HorizontalAlignment="Center" Margin="0,4,0,20" FontFamily="Tahoma" />

                <!-- Machine ID -->
                <TextBlock Text="MACHINE ID" FontSize="10" Foreground="{DynamicResource TextPrimaryBrush}" 
                           FontWeight="Bold" Margin="0,0,0,4" FontFamily="Tahoma" />
                <DockPanel Margin="0,0,0,4">
                    <Button x:Name="CopyButton" DockPanel.Dock="Right" Content="Copy" 
                            Click="CopyMachineId_Click" Margin="6,0,0,0"
                            Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11"
                            Padding="12,6" Cursor="Hand" FontFamily="Tahoma" BorderThickness="1"
                            BorderBrush="{DynamicResource BorderBrush}" Height="28" />
                    <Border Background="{DynamicResource InputBgBrush}" Padding="8,6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <TextBox x:Name="MachineIdText" IsReadOnly="True" Background="Transparent" 
                                 BorderThickness="0" FontFamily="Consolas" FontSize="11"
                                 Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    </Border>
                </DockPanel>
                <TextBlock Text="Send this ID to get your license key" FontSize="10" 
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16" FontFamily="Tahoma" />

                <!-- License Key -->
                <TextBlock Text="LICENSE KEY" FontSize="10" Foreground="{DynamicResource TextPrimaryBrush}" 
                           FontWeight="Bold" Margin="0,0,0,4" FontFamily="Tahoma" />
                <Border Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,0,12">
                    <TextBox x:Name="LicenseKeyInput" Padding="8,8" BorderThickness="0" FontSize="12"
                             FontFamily="Consolas" Foreground="{DynamicResource TextPrimaryBrush}" Background="Transparent"
                             CharacterCasing="Upper" />
                </Border>

                <!-- Name -->
                <TextBlock Text="LICENSED TO" FontSize="10" Foreground="{DynamicResource TextPrimaryBrush}" 
                           FontWeight="Bold" Margin="0,0,0,4" FontFamily="Tahoma" />
                <Border Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,0,20">
                    <TextBox x:Name="LicensedToInput" Padding="8,8" BorderThickness="0" FontSize="12"
                             FontFamily="Tahoma" Foreground="{DynamicResource TextPrimaryBrush}" Background="Transparent" />
                </Border>

                <!-- Error -->
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" FontSize="11" Margin="0,0,0,10"
                           Visibility="Collapsed" HorizontalAlignment="Center" FontFamily="Tahoma"
                           TextWrapping="Wrap" />

                <!-- Activate Button -->
                <Button x:Name="ActivateButton" Content="Activate License" Click="ActivateButton_Click"
                        Background="{DynamicResource PrimaryBrush}" Foreground="White" FontSize="12" FontWeight="Normal"
                        Padding="0,10" Cursor="Hand" FontFamily="Tahoma" BorderThickness="1"
                        BorderBrush="{DynamicResource PrimaryDarkBrush}" HorizontalContentAlignment="Center" />

                <!-- Continue without license -->
                <Button Content="Continue without license" Click="ContinueWithoutLicense_Click"
                        Margin="0,16,0,0" Style="{DynamicResource SecondaryButtonStyle}"
                        Padding="0,10" Cursor="Hand" FontSize="12"
                        HorizontalContentAlignment="Center" />
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
