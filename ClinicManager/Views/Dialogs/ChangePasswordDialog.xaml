<Window x:Class="ClinicManager.Views.Dialogs.ChangePasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Change Password Required"
        Height="480" Width="420" MinHeight="440" MinWidth="380"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Background="{DynamicResource BackgroundBrush}"
        WindowStyle="SingleBorderWindow">

    <Grid Margin="20">
        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="0"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header - fixed at top -->
                <StackPanel Grid.Row="0" Margin="28,24,28,16">
                    <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="32"
                               Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,12" />
                    <TextBlock Text="Change Password Required" FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,4" />
                    <TextBlock Text="You must set a new password before continuing." FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"
                               TextWrapping="Wrap" TextAlignment="Center" />
                    <TextBlock Text="Use 8+ characters with uppercase, lowercase, number and special character (e.g. MyPass@1)." FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,0"
                               TextWrapping="Wrap" TextAlignment="Center" />
                </StackPanel>

                <!-- Scrollable form -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Padding="28,8,28,8">
                    <StackPanel>
                        <TextBlock Text="New Password" Style="{DynamicResource FormLabelStyle}" />
                        <PasswordBox x:Name="NewPasswordBox" Margin="0,4,0,16"
                                     Style="{DynamicResource ModernPasswordBoxStyle}"
                                     Height="40" VerticalContentAlignment="Center" />

                        <TextBlock Text="Confirm Password" Style="{DynamicResource FormLabelStyle}" />
                        <PasswordBox x:Name="ConfirmPasswordBox" Margin="0,4,0,16"
                                     Style="{DynamicResource ModernPasswordBoxStyle}"
                                     Height="40" VerticalContentAlignment="Center" />

                        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}"
                                   FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </ScrollViewer>

                <!-- Button - fixed at bottom, always visible -->
                <Border Grid.Row="2" Padding="28,16,28,24" Background="{DynamicResource SurfaceBrush}">
                    <Button x:Name="OkButton" Content="Accept / Change Password" Click="OkButton_Click"
                            Style="{DynamicResource PrimaryButtonStyle}"
                            Background="{DynamicResource PrimaryBrush}"
                            Foreground="White"
                            Height="48" FontSize="14" FontWeight="SemiBold"
                            Padding="0" Cursor="Hand"
                            HorizontalAlignment="Stretch"
                            IsDefault="True" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
